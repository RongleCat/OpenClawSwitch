{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "OpenClawSwitch",
  "version": "2.0.0",
  "identifier": "com.openclawswitch.app",
  "build": {
    "beforeDevCommand": "node ./node_modules/vite/bin/vite.js",
    "beforeBuildCommand": "node ./scripts/bundle-openclaw.mjs && node ./scripts/bundle-node-runtime.mjs && node ./node_modules/vite/bin/vite.js build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "main",
        "title": "OpenClawSwitch",
        "width": 1000,
        "height": 600,
        "minWidth": 960,
        "minHeight": 580,
        "resizable": true,
        "center": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": [
      "resources/vendor/openclaw",
      "resources/vendor/node"
    ],
    "windows": {
      "digestAlgorithm": "sha256",
      "wix": {
        "language": "zh-CN"
      }
    }
  }
}
